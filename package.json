{
  "name": "dsh-context-snapshot",
  "version": "0.4.3",
  "description": "Attach the foreground window and accessible text to a DeepSeek Harness draft",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaelanvoss/dsh-context-snapshot.git"
  },
  "homepage": "https://github.com/kaelanvoss/dsh-context-snapshot#readme",
  "bugs": {
    "url": "https://github.com/kaelanvoss/dsh-context-snapshot/issues"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "native/macos/build/ContextSnapshot.app",
    "native/windows/publish",
    "README.md",
    "docs/draft-preview.png",
    "LICENSE",
    "VALIDATION.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "immediately": false
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/fetch-contract-fixture.mjs && node --test test/*.test.mjs",
    "test:contracts": "node scripts/fetch-contract-fixture.mjs && node --test test/contracts.test.mjs",
    "build:macos": "bash scripts/build-macos.sh",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "pack:check": "npm pack --dry-run",
    "pack:macos": "node scripts/pack.mjs macos",
    "pack:windows-x64": "node scripts/pack.mjs windows-x64",
    "pack:windows-arm64": "node scripts/pack.mjs windows-arm64"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1"
  }
}
